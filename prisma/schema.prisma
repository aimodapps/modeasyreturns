// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  id               String   @id @default(cuid())
  shopDomain       String   @unique
  returnWindowDays Int      @default(30)
  supportEmail     String?
  returnPolicyUrl  String?
  // Caps how many separate return/exchange requests can be submitted
  // against the same order -- not a cap on items per request (a customer
  // can still return several items together in one request). Null means
  // unlimited.
  maxReturnsPerOrder Int?
  // Shown as the storefront order-number field's placeholder text, e.g.
  // "#MOD0001" -- purely cosmetic, doesn't affect order lookup itself.
  orderNumberPlaceholder String?
  // Portal branding, all optional (falls back to plain defaults if unset).
  // logoUrl is the resolved CDN URL, captured once at upload time so every
  // storefront page load is a plain DB read, not a live Shopify Files call.
  logoUrl          String?
  logoWidthPx      Int?
  pageTitle        String?
  introDescription String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum ExclusionType {
  PRODUCT
  COLLECTION
  // Matched against a returned line item's own custom attributes (what
  // bundle-builder apps use to mark "this specific purchase was part of a
  // bundle") rather than the product it's for -- the same product bought
  // standalone stays returnable; only the bundled line item is excluded.
  LINE_ITEM_TAG
}

// App-level non-returnable list. Shopify's native "final sale" return
// rules (Settings -> Policies) are NOT readable via the Admin GraphQL API
// and are not reflected in returnableFulfillments (that field mirrors
// staff permissions, which can return final-sale items) -- confirmed via
// Shopify's own developer community. So this app has to track and enforce
// its own exclusion list rather than deferring to Shopify's config.
model ReturnExclusion {
  id         String        @id @default(cuid())
  shopDomain String
  type       ExclusionType
  // For PRODUCT/COLLECTION, the Shopify GID. For LINE_ITEM_TAG, the tag
  // text itself (matched as a case-insensitive substring against each line
  // item's "key: value" custom attributes) -- reused as the identifier so
  // the shopDomain+value uniqueness constraint still applies uniformly.
  shopifyResourceId String
  title             String
  createdAt         DateTime @default(now())

  @@unique([shopDomain, shopifyResourceId])
  @@index([shopDomain])
}

enum ConditionAction {
  PROCEED
  DENY
}

model ConditionOption {
  id          String           @id @default(cuid())
  shopDomain  String
  label       String
  code        String
  action      ConditionAction  @default(PROCEED)
  denyMessage String?
  denyLinkUrl String?
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lineItems ReturnRequestLineItem[]

  @@unique([shopDomain, code])
}

model ReturnReason {
  id            String   @id @default(cuid())
  shopDomain    String
  label         String
  code          String
  message       String
  requiresPhoto Boolean  @default(false)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lineItems ReturnRequestLineItem[]

  @@unique([shopDomain, code])
}

enum ReturnStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  DENIED
  CANCELLED
}

enum ShippingMethod {
  OWN_CARRIER
  RETURN_LABEL
}

// Only meaningful once status = APPROVED; tracks the post-approval
// physical-return / exchange-fulfillment journey on the *same* Shopify
// order (see ExchangeSelection/exchangeLineItems -- there is no separate
// draft order anymore).
enum ReturnLifecycleStage {
  AWAITING_RECEIPT // Return/Exchange Accepted -- waiting for the item to be received & inspected
  BALANCE_DUE // Received & inspected; exchange created a balance, invoice not yet sent
  INVOICE_SENT // Invoice sent (Awaiting Payment)
  COMPLETED // Refund issued / no balance due / fully resolved
}

enum RefundMethod {
  ORIGINAL_PAYMENT_METHOD
  STORE_CREDIT
}

model ReturnRequest {
  id                 String                @id @default(cuid())
  shopDomain         String
  orderId            String
  orderName          String
  customerEmail      String?
  customerPhone      String?
  // Collected in the wizard specifically for the return carrier (some
  // require a phone number to schedule pickup) -- distinct from
  // customerPhone above, which is only ever the identity-verification value
  // typed at order lookup and may not even belong to this order's shipping
  // address. Pushed onto the order's Shopify shipping address when the
  // admin approves the request, not before.
  returnContactPhone String?
  status             ReturnStatus          @default(DRAFT)
  orderSnapshot      Json
  shippingMethod     ShippingMethod?
  shippingFeeAmount  Decimal?              @db.Decimal(10, 2)
  // True once staff have waived shippingFeeAmount down to 0 as a customer
  // service exception -- kept separate from a request that simply never had
  // a fee, so the admin UI can say "waived" rather than showing a bare $0.
  shippingFeeWaived  Boolean               @default(false)
  // Only meaningful for the portion of the request that gets an actual
  // cash-equivalent refund (plain-return items) -- exchanged items' value
  // is netted natively into the order balance regardless of this choice.
  // Null for requests submitted before this field existed, or where no
  // refund ever applies (fully exchanged with no balance owed back).
  refundMethod       RefundMethod?
  submittedAt        DateTime?
  adminNote          String?
  // Freeform staff-only notes (e.g. "customer emailed asking about X, told
  // them Y") -- deliberately separate from adminNote, which is sometimes
  // shown to the customer (denial reason on the status page/email). Never
  // surfaced anywhere in the customer-facing wizard.
  internalNote       String?
  decidedAt          DateTime?
  decidedByStaff     String?
  shopifyReturnId    String?
  shopifyReturnName  String?
  shopifyRefundId    String?
  lifecycleStage     ReturnLifecycleStage?
  receivedAt         DateTime?
  invoiceSentAt      DateTime?
  refundIssuedAmount Decimal?              @db.Decimal(10, 2)
  balanceDueAmount   Decimal?              @db.Decimal(10, 2)
  balanceDueCurrency String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  lineItems     ReturnRequestLineItem[]
  photos        PhotoUpload[]
  notifications AdminNotificationLog[]

  @@index([shopDomain, status])
}

enum NotificationType {
  RETURN_INITIATED
  RETURN_APPROVED
  RETURN_DENIED
  RETURN_RECEIVED
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

model AdminNotificationLog {
  id                String             @id @default(cuid())
  returnRequestId   String
  type              NotificationType
  recipientEmail    String
  provider          String             @default("resend")
  providerMessageId String?
  status            NotificationStatus @default(SENT)
  errorMessage      String?
  sentAt            DateTime           @default(now())

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
}

model PhotoUpload {
  id               String   @id @default(cuid())
  returnRequestId  String
  shopifyFileId    String
  originalFilename String?
  uploadedAt       DateTime @default(now())

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
}

model ReturnRequestLineItem {
  id                   String   @id @default(cuid())
  returnRequestId      String
  fulfillmentLineItemId String
  shopifyLineItemId    String
  title                String
  variantTitle         String?
  quantity             Int
  unitPrice            Decimal  @db.Decimal(10, 2)
  currencyCode         String
  conditionOptionId    String?
  conditionDenied      Boolean  @default(false)
  reasonId             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  returnRequest     ReturnRequest      @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  conditionOption   ConditionOption?   @relation(fields: [conditionOptionId], references: [id])
  reason            ReturnReason?      @relation(fields: [reasonId], references: [id])
  exchangeSelection ExchangeSelection?

  @@unique([returnRequestId, fulfillmentLineItemId])
}

model ExchangeUpsellProduct {
  id               String   @id @default(cuid())
  shopDomain       String
  shopifyProductId String
  shopifyVariantId String?
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
}

enum PriceDiffDirection {
  CHARGE
  REFUND
  NONE
}

model ExchangeSelection {
  id                      String             @id @default(cuid())
  returnRequestLineItemId String             @unique
  targetProductId         String
  targetVariantId         String
  targetTitle             String
  targetVariantTitle      String?
  targetImageUrl          String?
  targetUnitPrice         Decimal            @db.Decimal(10, 2)
  currencyCode            String
  priceDifference         Decimal            @db.Decimal(10, 2)
  direction               PriceDiffDirection
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  returnRequestLineItem ReturnRequestLineItem @relation(fields: [returnRequestLineItemId], references: [id], onDelete: Cascade)
}

enum DiscountRuleType {
  ORDER_PERCENTAGE
  ORDER_FIXED_AMOUNT
  QTY_BREAK_PERCENTAGE
  QTY_BREAK_FIXED_AMOUNT
}

enum DiscountScope {
  ALL_ITEMS
  SPECIFIC_PRODUCTS
}

model DiscountRule {
  id                 String           @id @default(cuid())
  shopDomain         String
  discountTitleMatch String
  discountCode       String?
  type               DiscountRuleType
  minQuantity        Int?
  minAmount          Decimal?         @db.Decimal(10, 2)
  discountValue      Decimal          @db.Decimal(10, 2)
  appliesTo          DiscountScope    @default(ALL_ITEMS)
  scopeProductIds    Json?
  // Optional campaign window -- lets the same discount title/code be
  // reconfigured across separate occasional runs (e.g. "Buy 3 Get 20% off"
  // with different terms each time) without an order from an older run
  // being evaluated against whichever terms happen to be saved today.
  // Null on either end means unbounded in that direction.
  validFrom          DateTime?
  validUntil         DateTime?
  isActive           Boolean          @default(true)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

enum FeeType {
  PERCENTAGE
  FIXED_AMOUNT
}

model RestockingFeeConfig {
  id         String   @id @default(cuid())
  shopDomain String   @unique
  feeType    FeeType  @default(PERCENTAGE)
  value      Decimal  @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model ReturnLabelFeeConfig {
  id            String   @id @default(cuid())
  shopDomain    String   @unique
  amountPerItem Decimal  @db.Decimal(10, 2) @default(5.99)
  currency      String   @default("USD")
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}
